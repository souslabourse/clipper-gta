# Copier vers /etc/clipper.env sur le serveur (chmod 600). Jamais dans Git.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Un compte Buffer gratuit par langue (3 chaînes max par compte gratuit).
BUFFER_KEY_FR=
BUFFER_KEY_EN=
# Rempli après "python -m clipper channels" : service:id séparés par des virgules.
BUFFER_CHANNELS_FR=tiktok:xxxxxxxxxxxxxxxxxxxxxxxx,youtube:xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_CHANNELS_EN=tiktok:xxxxxxxxxxxxxxxxxxxxxxxx,youtube:xxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Rempli par setup.sh (https://<ip-avec-tirets>.sslip.io/v)
PUBLIC_BASE_URL=
CLIPPER_DATA=/opt/clipper/data
